{
  "name": "@teyfix/directory-loader",
  "version": "0.1.0",
  "private": true,
  "description": "Compose structured files into a deeply merged object with a Bun-native chained pipeline.",
  "keywords": [
    "json",
    "yaml",
    "loader"
  ],
  "homepage": "https://github.com/teyfix/directory-loader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teyfix/directory-loader.git"
  },
  "license": "ISC",
  "author": "Halil Teyfik Dolmaci (hlltvfk@gmail.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/directory-loader.factory.ts",
      "import": "./src/directory-loader.factory.ts"
    }
  },
  "bin": {
    "directory-loader": "./src/directory-loader.cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "bun build src/directory-loader.factory.ts src/directory-loader.cli.ts --target=bun --outdir=dist",
    "check": "bun check",
    "format": "bun run format:biome && bun run format:prettier",
    "format:biome": "bun --bun biome check --write src test",
    "format:check": "bun --bun biome check src test && bun --bun prettier --check .",
    "format:prettier": "bun --bun prettier --write .",
    "prepare": "bun --bun lefthook install",
    "test": "bun test",
    "verify": "bun run format:check && bun run check && bun test && bun run build"
  },
  "dependencies": {
    "@bunli/core": "0.9.1",
    "deepmerge-ts": "8.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-compact-markdown-table": "0.1.0",
    "prettier-plugin-packagejson": "3.1.0",
    "prettier-plugin-sh": "0.20.2",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-toml": "4.1.0"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  }
}
